        },
        {
            "m_Id": "2d5925e7544d474482ae797f0153aef7"
        },
        {
            "m_Id": "c004a87405d54bf1a8d51b2e3aa9b87e"
        },
        {
            "m_Id": "74fbc82bd4de41efb914f921d9f24c5a"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 2,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLigth",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if  SHADERGRAPH_PREVIEW\n\tDirection = half3(0.5,0.5,0);\n\tColor = 1;\n\tDistanceAtten = 1;\n\tShadowAtten = 1;\n#else\n#if   SHADOWS_SCREEN // Fixed typo (SHADOWWS_SCREEN -> SHADOWS_SCREEN)\n\thalf4 clipPos = TransformWorldToHClip(WorldPos);\n\thalf4 shadowCoord = ComputeScreenPos(clipPos);\n#else\n\thalf4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n#endif\n\tLight light = GetMainLight();\n\tDirection = light.direction;\n\tColor = light.color; // Added missing semicolon\n\tDistanceAtten = light.distanceAttenuation;\n\tShadowAtten = light.shadowAttenuation;\n#endif"
}

